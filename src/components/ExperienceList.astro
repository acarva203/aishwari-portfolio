---
import type { Role } from '../data/experience';

interface Props {
  roles: Role[];
}
const { roles } = Astro.props;
---

<div class="xp">
  {roles.map((r, i) => {
    const expandable = r.points.length > 0 || Boolean(r.tools?.length) || Boolean(r.poster);
    const Item = expandable ? 'details' : 'div';
    const Heading = expandable ? 'summary' : 'div';
    return (
    <Item id={r.projectId ? `project-${r.projectId}` : undefined} class="xp-item">
      <Heading class="xp-summary" style={!expandable ? "cursor:default" : undefined}>
        <span class="xp-num mono">{String(i + 1).padStart(2, '0')}</span>
        <span class="xp-head">
          <span class="xp-role">{r.role}</span>
          <span class="xp-org mono"><span class="venue">{r.org}</span>{r.location ? ` · ${r.location}` : ''}</span>
        </span>
        <span class="xp-period mono">{r.period}</span>
        {expandable && <span class="xp-toggle mono" aria-hidden="true">+</span>}
      </Heading>
      {expandable && <div class="xp-body">
          <ul class="xp-points">
            {r.points.map(point => <li>{point}</li>)}
          </ul>
          {r.tools && r.tools.length > 0 && <div class="chips chips--light">
            {r.tools.map(tool => <span class="chip">{tool}</span>)}
          </div>}
          {r.poster && <figure class="experience-poster">
            <a href={r.poster.src} target="_blank" rel="noopener" aria-label={`${r.poster.title} — open full-size poster in a new tab`}>
              <img src={r.poster.src} alt={r.poster.alt} width="4608" height="3456" loading="lazy" decoding="async" />
            </a>
            <figcaption><span>{r.poster.title}</span><a href={r.poster.src} target="_blank" rel="noopener" aria-label={`View full-size poster: ${r.poster.title} (opens in a new tab)`}>View full-size poster ↗</a></figcaption>
          </figure>}
      </div>}
    </Item>
  ); })}
</div>
