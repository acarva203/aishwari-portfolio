---
import type { Role } from '../data/experience';

interface Props {
  roles: Role[];
  open?: boolean; // default-expanded (used on /resume)
}
const { roles, open = false } = Astro.props;
---

<div class="xp">
  {roles.map((r, i) => {
    const expandable = r.points.length > 0 || Boolean(r.tools?.length);
    const Item = expandable ? 'details' : 'div';
    const Heading = expandable ? 'summary' : 'div';
    return (
    <Item id={r.projectId ? `project-${r.projectId}` : undefined} class="xp-item" open={expandable ? open : undefined}>
      <Heading class="xp-summary" style={!expandable ? "cursor:default" : undefined}>
        <span class="xp-num mono">{String(i + 1).padStart(2, '0')}</span>
        <span class="xp-head">
          <span class="xp-role">{r.role}</span>
          <span class="xp-org mono"><span class="venue">{r.org}</span>{r.location ? ` · ${r.location}` : ''}</span>
        </span>
        <span class="xp-period mono">{r.period}</span>
        {expandable && <span class="xp-toggle mono" aria-hidden="true">+</span>}
      </Heading>
      {expandable && <div class="xp-body">
          <ul class="xp-points">
            {r.points.map(point => <li>{point}</li>)}
          </ul>
          {r.tools && r.tools.length > 0 && <div class="chips chips--light">
            {r.tools.map(tool => <span class="chip">{tool}</span>)}
          </div>}
      </div>}
    </Item>
  ); })}
</div>
