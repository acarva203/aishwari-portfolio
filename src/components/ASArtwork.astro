---
interface Props { variant?: 'logo' | 'emergence' }
const { variant = 'logo' } = Astro.props;
const maskId = `as-mask-${variant}`;
---

<svg class:list={['as-artwork', { 'as-emergence': variant === 'emergence' }]} viewBox="0 0 2505.087 2505.087" aria-hidden="true">
  <defs>
    <mask id={maskId} maskUnits="userSpaceOnUse" x="574.213" y="840.125" width="1296.064" height="720.703" style="mask-type:alpha">
      <image href="/assets/rings/as-mask.svg" x="574.213" y="840.125" width="1296.064" height="720.703" />
    </mask>
  </defs>
  {[194, 195, 196, 197].map((ring, index) => (
    <image class:list={['as-ring', index % 2 === 0 ? 'as-forward' : 'as-reverse']} style={`--ring-delay:${index * 90}ms`} href={`/assets/rings/ring-${ring}.svg`} width="2505.087" height="2505.087" />
  ))}
  <image href="/assets/rings/as-fill.svg" x="609" y="570" width="1297" height="1297" mask={`url(#${maskId})`} />
</svg>

<style>
  .as-artwork { display: block; width: 100%; height: 100%; }
  .as-ring { transform-origin: 1252.424px 1252.543px; }
  .as-emergence.is-playing .as-ring { animation: emerge 1870ms cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: var(--ring-delay); }
  .as-emergence .as-forward { --rotation-start: -320deg; --rotation-end: 80deg; transform: rotate(80deg) scale(1.04); }
  .as-emergence .as-reverse { --rotation-start: 320deg; --rotation-end: -80deg; transform: rotate(-80deg) scale(1.04); }
  .as-emergence.is-waiting .as-ring { opacity: 0; }
  @keyframes emerge {
    from { opacity: 0; transform: rotate(var(--rotation-start)) scale(.08); }
    30% { opacity: 1; }
    to { opacity: 1; transform: rotate(var(--rotation-end)) scale(1.04); }
  }
  @media (prefers-reduced-motion: reduce) {
    .as-emergence.is-playing .as-ring { animation: none; }
  }
</style>
