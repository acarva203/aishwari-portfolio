---
// Single-page notebook shell: artwork, section navigation, and footer.
import '../styles/global.css';
import ASArtwork from '../components/ASArtwork.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  intro?: boolean;
  title?: string;
  description?: string;
}
const {
  intro = false,
  title = 'Aishwari Sirur — notebook',
  description = 'Aishwari Sirur — AI engineering intern candidate. CS at UC Davis working across AI, data science, and product. Portfolio rendered as a notebook.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    {intro && <script is:inline>
      try {
        if ((!localStorage.getItem('as-intro-dismissed') || new URLSearchParams(location.search).has('test-intro'))) {
          document.documentElement.classList.add('intro-active');
        }
      } catch (e) {}
    </script>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Enable scroll-reveal only when JS runs and motion is allowed. Set on
      // <html> before paint so there is no flash of invisible cells.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-anim');
      }
    </script>
  </head>
  <body>
    <Analytics />
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="masthead-in">
        <div class="brand">
          <button class="brand-link brand-roll" type="button" aria-label="Roll the AS logo across the navbar"><span class="brand-artwork"><ASArtwork /></span></button>
        </div>
        <button class="mobile-menu-toggle mono" type="button" aria-expanded="false" aria-controls="section-nav" hidden>Menu</button>
        <nav class="nav" id="section-nav" aria-label="Sections">
          <a href="#experience">experience</a>
          <a class="cta" href="#education">education</a>
          <a href="#log">explorations</a>
          <a class="cta kw" href="#contact">contact →</a>
        </nav>
      </div>
    </header>

    <script>
      const logoButton = document.querySelector<HTMLButtonElement>('.brand-roll');
      const rollingLogo = logoButton?.querySelector<HTMLElement>('.brand-artwork');
      const navbar = document.querySelector<HTMLElement>('.masthead-in');
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let roll: Animation | undefined;
      function stopRoll() {
        roll?.cancel();
        roll = undefined;
      }
      logoButton?.addEventListener('click', () => {
        if (!rollingLogo || !navbar || roll) return;
        if (reducedMotion.matches) {
          roll = rollingLogo.animate([{ opacity: 1 }, { opacity: .55 }, { opacity: 1 }], { duration: 250 });
        } else {
          const logoRect = rollingLogo.getBoundingClientRect();
          const barRect = navbar.getBoundingClientRect();
          const distance = Math.max(0, barRect.right - logoRect.right - 20);
          const turns = distance / (Math.PI * logoRect.width) * 360;
          roll = rollingLogo.animate([
            { transform: 'translateX(0) rotate(0deg)', offset: 0 },
            { transform: `translateX(${distance}px) rotate(${turns}deg)`, offset: .48 },
            { transform: `translateX(${distance}px) rotate(${turns}deg)`, offset: .52 },
            { transform: 'translateX(0) rotate(0deg)', offset: 1 },
          ], { duration: 1800, easing: 'ease-in-out' });
        }
        roll.finished.then(stopRoll, stopRoll);
      });
      window.addEventListener('resize', stopRoll);
      reducedMotion.addEventListener('change', stopRoll);

      const menuToggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
      const sectionNav = document.querySelector<HTMLElement>('#section-nav');
      const mobileMenu = matchMedia('(max-width: 560px)');
      if (menuToggle && sectionNav) {
        menuToggle.hidden = false;
        function setMenu(open: boolean) {
          menuToggle!.setAttribute('aria-expanded', String(open));
          menuToggle!.textContent = open ? 'Close menu' : 'Menu';
          sectionNav!.classList.toggle('is-open', open);
        }
        menuToggle.addEventListener('click', () => setMenu(menuToggle.getAttribute('aria-expanded') !== 'true'));
        sectionNav.addEventListener('click', event => {
          if ((event.target as HTMLElement).closest('a') && mobileMenu.matches) setMenu(false);
        });
        document.addEventListener('keydown', event => {
          if (event.key === 'Escape' && mobileMenu.matches && menuToggle.getAttribute('aria-expanded') === 'true') {
            setMenu(false);
            menuToggle.focus();
          }
        });
        mobileMenu.addEventListener('change', () => setMenu(false));
      }
    </script>

    <main class="wrap" id="main">
      <slot />
      <footer class="foot">
        <span>© {new Date().getFullYear()} Aishwari Sirur — rendered as a notebook.</span>
        <span class="com"># built with Astro · aishwari sirur — ai engineer</span>
      </footer>
    </main>

    <script>
      // Native notebook motion: cells "execute" (reveal) as they scroll in,
      // orchestrated once. Respects reduced-motion via CSS; here we just add the
      // run class. If IO is unavailable, everything is visible by default.
      const cells = document.querySelectorAll('.cell');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!('IntersectionObserver' in window) || reduce) {
        cells.forEach((c) => c.classList.add('run'));
      } else {
        // Reveal anything already in the first viewport synchronously — no
        // above-the-fold flash — then observe the rest.
        const vh = window.innerHeight;
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('run');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        cells.forEach((c) => {
          if (c.getBoundingClientRect().top < vh * 0.9) c.classList.add('run');
          else io.observe(c);
        });
        // safety: reveal anything still hidden after load
        window.addEventListener('load', () =>
          setTimeout(() => cells.forEach((c) => c.classList.add('run')), 1200)
        );
      }
    </script>
  </body>
</html>
