---
import Notebook from '../layouts/Notebook.astro';
import ContactForm from '../components/ContactForm.astro';
import { getCollection, render } from 'astro:content';
import { experience } from '../data/experience';
import ExperienceList from '../components/ExperienceList.astro';
import { skills } from '../data/skills';

const experienceProjectIds = new Set(experience.map(role => role.projectId).filter(Boolean));
const projects = (await getCollection('projects')).filter(project => !experienceProjectIds.has(project.id)).sort(
  (a, b) => a.data.order - b.data.order
);
const updates = (await getCollection('updates')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const updateDetails = await Promise.all(updates.map(async (update) => ({ update, ...(await render(update)) })));
const projectDetails = await Promise.all(projects.map(async (project) => ({ project, ...(await render(project)) })));
const featured = projects.find((p) => p.data.featured) ?? projects[0];
const restProjects = projects.filter((p) => p.id !== featured?.id);

const catCode: Record<string, string> = {
  'AI / ML': 'AI',
  'Data Science': 'DS',
  Product: 'PM',
  Design: 'DES',
  Engineering: 'ENG',
};
const idFor = (cats: string[], n: number) =>
  `${catCode[cats[0]] ?? 'SR'}·${String(n).padStart(3, '0')}`;

---

<Notebook>
  <h1 class="sr-only">Aishwari Sirur — AI Engineer</h1>

  {/* In[1] — introduction */}
  <section class="hero-pin-wrap" id="about">
   <div class="hero-pin">
    <section class="cell">
      <div class="cell-gutter">In[<span>1</span>]:</div>
      <div class="cell-body">
        <div class="celltag mono">whoami<span class="com">()  → identity</span></div>
        <p class="prose lead" id="hero-statement">
          I'm <strong>Aishwari Sirur</strong>, a CS major at <strong>UC Davis</strong>
          building at the intersection of <strong>AI, data, and product</strong>.
          I’m focused on testing and deploying models in production-grade environments,
          turning promising experiments into reliable tools people can use.
        </p>
        <p class="comment-line">cs &amp; business @ uc davis</p>
        <div class="hero-actions mono"><a class="primary-link" href="#experience">View my experience ↓</a><a href="#contact">Get in touch →</a><span class="hero-socials">
          <a class="social-icon" href="https://github.com/acarva203" rel="noopener" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15A10.8 10.8 0 0 1 12 6.16c.96 0 1.92.13 2.82.38 2.15-1.45 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.63 5.27-5.14 5.55.4.35.76 1.04.76 2.1v3.09c0 .3.21.65.78.54A11.25 11.25 0 0 0 12 .75Z" /></svg>
          </a>
          <a class="social-icon" href="https://www.linkedin.com/in/aishwari-sirur" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.31h.04c.39-.75 1.36-1.55 2.79-1.55 2.99 0 3.55 1.97 3.55 4.53v5.26Z" /></svg>
          </a>
        </span></div>
        <details class="peek">
          <summary>source</summary>
          <pre><span class="kw">def</span> <span class="fn">whoami</span>():
    <span class="kw">return</span> Person(
        name=<span class="str">"Aishwari Sirur"</span>,
        school=<span class="str">"UC Davis — CS &amp; Business"</span>,
        focus=[<span class="str">"AI engineering"</span>, <span class="str">"data science"</span>, <span class="str">"product"</span>],
        now=[<span class="str">"ADK"</span>, <span class="str">"Gemini Enterprise"</span>, <span class="str">"agentic workflows"</span>],
    )  <span class="com"># scroll for the work ↓</span></pre>
        </details>
      </div>
    </section>
   </div>
  </section>

  {/* Fig.1 — featured, rendered as output */}
  {featured && (
    <section class="cell" id="featured" hidden style="display: none">
      <div class="cell-gutter">Out[<span class="out">1</span>]:</div>
      <div class="cell-body">
        <div class="celltag mono"><span class="fn">render</span>(featured) — Fig.1</div>
        <div class="figure">
          <div class="figure-bar">
            <span class="dots" aria-hidden="true">
              <span class="dot" style="background:#ff5f56"></span>
              <span class="dot" style="background:#ffbd2e"></span>
              <span class="dot" style="background:#27c93f"></span>
            </span>
            <span>featured · {featured.data.categories.join(' · ')}</span>
            <span class="caption">Fig.1</span>
          </div>
          <div class="figure-body">
            <h2 class="figure-title">{featured.data.title}</h2>
            <p class="figure-stat"><span class="num">{featured.data.metricValue}</span> {featured.data.metricLabel}</p>
            <p class="figure-blurb">{featured.data.blurb}</p>

            {/* authored output panel — a real summary readout, not a gradient */}
            <div class="summary" aria-hidden="true">
              <div><span class="prompt">In[*]:</span> project.summary()</div>
              <dl>
                <div><dt>metric</dt><dd><span class="num">{featured.data.metricValue}</span> — {featured.data.metricLabel}</dd></div>
                <div><dt>timeline</dt><dd>{featured.data.timeline} · {featured.data.team}</dd></div>
                <div><dt>stack</dt><dd>{featured.data.tools.join(' · ')}</dd></div>
              </dl>
            </div>

            <div class="chips">
              {featured.data.tools.map((s) => <span class="chip">{s}</span>)}
            </div>

            <div class="figure-actions">
              <a href={`#project-${featured.id}`}>read case study <span class="arr">→</span></a>
              {featured.data.href && (
                <a href={featured.data.href} rel="noopener">live <span class="arr">↗</span></a>
              )}
              {featured.data.repo && (
                <a href={featured.data.repo} rel="noopener">code <span class="arr">↗</span></a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  {/* In[2] — projects */}
  {restProjects.length > 0 && (
    <section class="cell" id="projects" hidden style="display: none">
      <div class="cell-gutter" aria-hidden="true" style="visibility: hidden">In[<span>2</span>]:</div>
      <div class="cell-body">
        <div class="celltag celltag--row mono"><span><span class="fn">projects</span>.list(<span class="com">exclude=featured</span>)</span><span class="viewall">{projects.length} projects</span></div>
        <div class="entries">
          {restProjects.map((p, i) => (
            <a class="entry" href={`#project-${p.id}`}>
              <span class="entry-id">{idFor(p.data.categories, i + 2)}</span>
              <span class="entry-main">
                <span class="entry-title">
                  {p.data.title}{' '}
                  {p.data.href && <span class="arr">↗</span>}
                </span>
                <span class="entry-blurb">{p.data.blurb}</span>
                {p.data.tools.length > 0 && (
                  <span class="entry-tools mono">{p.data.tools.slice(0, 4).join(' · ')}</span>
                )}
              </span>
              <span class="entry-meta">{p.data.categories.join(' · ')}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Temporarily hidden; retain case studies here for future use. */}
  <section class="cell" id="case-studies" hidden style="display: none">
    <div class="cell-gutter">Out[<span class="out">2</span>]:</div>
    <div class="cell-body">
      <h2 class="section-title">Behind the work</h2>
      <div class="project-details">
        {projectDetails.map(({ project: p, Content }) => (
          <details class="project-detail" id={`project-${p.id}`}>
            <summary><span>{p.data.title}</span><span class="detail-toggle" aria-hidden="true">+</span></summary>
            <div class="project-content">
              <p class="project-meta mono">{p.data.timeline} · {p.data.team}</p>
              <div class="article-body"><Content /></div>
              <div class="chips chips--light">{p.data.tools.map(tool => <span class="chip">{tool}</span>)}</div>
              {(p.data.href || p.data.repo) && <p class="project-links mono">
                {p.data.href && <a href={p.data.href}>Visit project ↗</a>}
                {p.data.repo && <a href={p.data.repo}>View code ↗</a>}
              </p>}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* In[2] — tech-stack showcase */}
  <section class="cell" id="stack">
    <div class="cell-gutter">In[<span>2</span>]:</div>
    <div class="cell-body">
      <div class="celltag mono"><span class="fn">stack</span>  <span class="com"># tools I reach for</span></div>
      {skills.map(({ group, items }) => <div class="skillgroup" hidden={group === 'Design & Front-end'}>
        <h3 class="glabel">{group}</h3>
        <div class="chips chips--light stack-chips">
          {items.map(item => <span class="chip">{item}</span>)}
        </div>
      </div>)}
    </div>
  </section>

  {/* In[3] — full experience, expandable inline */}
  {experience.some((r) => r.highlight) && (
    <section class="cell" id="experience">
      <div class="cell-gutter">In[<span>3</span>]:</div>
      <div class="cell-body">
        <div class="celltag celltag--row mono"><span><span class="fn">experience</span>.timeline()</span><a class="viewall" href="#education">education ↓</a></div>
        <ExperienceList roles={experience} />
      </div>
    </section>
  )}

  <section class="cell" id="education">
    <div class="cell-gutter">In[<span>4</span>]:</div>
    <div class="cell-body">
      <h2 class="section-title">Education</h2>
      <h3>University of California, Davis</h3>
      <p>B.S. Computer Science · Minor in Business</p>
      <p class="comment-line">currently exploring ADK, Gemini Enterprise, and agentic workflows</p>
    </div>
  </section>

  <section class="cell" id="log">
    <div class="cell-gutter">In[<span>5</span>]:</div>
    <div class="cell-body">
      <h2 class="section-title" id="notes-heading">Projects I’m exploring</h2>
      <div class="notes-carousel" role="region" aria-roledescription="carousel" aria-labelledby="notes-heading">
        <div class="notes-track" id="notes-track" tabindex="0" aria-label="Projects I’m exploring. Use left and right arrow keys to browse.">
          {updateDetails.map(({ update, Content }, index) => <article class="note-slide" role="group" aria-roledescription="slide" aria-label={`${index + 1} of ${updateDetails.length}`}>
            <p class="project-meta mono"><time datetime={update.data.date}>{update.data.date}</time> · {update.data.tag}</p>
            <h3>{update.data.title}</h3>
            <div class="article-body"><Content /></div>
          </article>)}
        </div>
        {updateDetails.length > 1 && <div class="notes-controls" hidden>
          <span class="mono" data-note-position aria-live="polite" aria-atomic="true">1 / {updateDetails.length}</span>
          <div class="notes-buttons">
            <button type="button" data-note-prev aria-controls="notes-track" aria-label="Previous note" disabled>Previous</button>
            <button type="button" data-note-next aria-controls="notes-track" aria-label="Next note">Next</button>
          </div>
        </div>}
      </div>
    </div>
  </section>

  {/* Out[] — contact */}
  <section class="cell" id="contact">
    <div class="cell-gutter">Out[<span class="out">∎</span>]:</div>
    <div class="cell-body">
      <div class="outcell">
        <h2>Let's build something.</h2>
        <p>Have a role, a project, or a question? I’d love to hear from you.</p>
        <div class="outlinks">
          <a href="https://www.linkedin.com/in/aishwari-sirur" rel="noopener">linkedin <span class="arr">↗</span></a>
          <a href="https://github.com/acarva203" rel="noopener">github <span class="arr">↗</span></a>
        </div>
      </div>
      <h2 class="section-title" id="contact-form-heading" style="margin-top:2rem">Contact</h2>
      <ContactForm />
    </div>
  </section>
</Notebook>

<script>
  function openProject() {
    const id = decodeURIComponent(window.location.hash.slice(1));
    const detail = document.getElementById(id);
    if (detail instanceof HTMLDetailsElement) detail.open = true;
  }
  window.addEventListener("hashchange", openProject);
  openProject();
</script>

<script>
  const track = document.querySelector<HTMLElement>('.notes-track');
  const previous = document.querySelector<HTMLButtonElement>('[data-note-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-note-next]');
  const position = document.querySelector<HTMLElement>('[data-note-position]');
  const controls = document.querySelector<HTMLElement>('.notes-controls');
  if (track && previous && next && position && controls) {
    controls.hidden = false;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.note-slide'));
    const current = () => slides.reduce((best, slide, index) =>
      Math.abs(slide.offsetLeft - track.scrollLeft) <
      Math.abs(slides[best].offsetLeft - track.scrollLeft) ? index : best, 0);
    const sync = () => {
      const index = current();
      previous.disabled = index === 0;
      next.disabled = index === slides.length - 1;
      position.textContent = `${index + 1} / ${slides.length}`;
    };
    const move = (direction: number) => {
      const index = Math.max(0, Math.min(slides.length - 1, current() + direction));
      track.scrollTo({ left: slides[index].offsetLeft,
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    };
    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('scroll', sync, { passive: true });
    track.addEventListener('keydown', event => {
      if (event.target !== track) return;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        move(event.key === 'ArrowLeft' ? -1 : 1);
      }
    });
    window.addEventListener('resize', sync);
    sync();
  }
</script>
